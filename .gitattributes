# Binary art, model and audio assets are stored through Git LFS. This mirrors the Engine workspace
# root so a package repository applies the same storage policy as the workspace that mounts it.
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.pgm filter=lfs diff=lfs merge=lfs -text
*.armesh filter=lfs diff=lfs merge=lfs -text
*.ariweights filter=lfs diff=lfs merge=lfs -text

# The scatter generator writes canonical UTF-8/LF bytes into a Generated directory beside the recipe
# that produced them, and tests compare tracked fixtures against regenerated output byte for byte.
# These artifacts must never be normalized by an end-of-line conversion.
*.arivegetationgenerated -text
*.arivegetationgenerated.meta -text