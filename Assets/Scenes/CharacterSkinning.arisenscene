# The skinning sample: an imported game character on the showcase floor. The mesh is drawn through
# its material's SKINNED variant and its head and shoulders are posed by com.arisen.samples' own
# driver, so a run whose driver never engages shows the imported T-pose - arms straight out - and a
# run that skinning works in shows the character standing with its arms at its sides.
Version: 2
Name: Character Skinning
ComponentSchemas:
- TypeId: 1
  Name: Transform
  Version: 1
  Required: true
- TypeId: 2
  Name: Camera
  Version: 2
  Required: true
- TypeId: 3
  Name: MeshRenderer
  Version: 1
  Required: true
- TypeId: 4
  Name: DirectionalLight
  Version: 1
  Required: true
- TypeId: 7
  Name: Environment
  Version: 1
  Required: true
Entities:
- Guid: 43000000-0000-0000-0000-000000000001
  Name: Main Camera
  Transform:
    Position: { X: 0.0, Y: 1.3, Z: -4.0 }
    Rotation: { X: 0.0523360, Y: 0.0, Z: 0.0, W: 0.9986295 }
    Scale: { X: 1.0, Y: 1.0, Z: 1.0 }
  Camera:
    VerticalFov: 45.0
    NearPlane: 0.1
    FarPlane: 200.0
    IsPerspective: true
- Guid: 43000000-0000-0000-0000-000000000002
  Name: Skinning Key Light
  DirectionalLight:
    # The key light sits above the camera's shoulder, so the figure's shadow falls towards the
    # viewer: the pose that deforms the lit mesh is the same pose its shadow casts.
    Direction: { X: -0.35, Y: 0.8, Z: 0.48 }
    Color: { X: 1.0, Y: 0.95, Z: 0.87 }
    Intensity: 1.6
    AmbientIntensity: 0.12
    Enabled: true
- Guid: 43000000-0000-0000-0000-000000000003
  Name: Skinning Environment
  Environment:
    SkyColor: { X: 0.04, Y: 0.12, Z: 0.22 }
    HorizonColor: { X: 0.5, Y: 0.63, Z: 0.72 }
    GroundColor: { X: 0.05, Y: 0.06, Z: 0.07 }
    AmbientColor: { X: 0.4, Y: 0.5, Z: 0.62 }
    SkyIntensity: 0.95
    AmbientIntensity: 0.24
    Enabled: true
- Guid: 43000000-0000-0000-0000-000000000004
  Name: Skinning Floor
  Transform:
    Position: { X: 0.0, Y: 0.0, Z: 0.0 }
    Rotation: { X: 0.0, Y: 0.0, Z: 0.0, W: 1.0 }
    Scale: { X: 2.0, Y: 1.0, Z: 2.0 }
  MeshRenderer:
    Mesh: { Guid: 0fed982b-5130-430e-860b-dc9c7284b8c1, PackageId: com.arisen.samples }
    Material: { Guid: e87b0335-5689-45a0-9fe1-455a01b59a20, PackageId: com.arisen.samples }
    Visible: true
- Guid: 43000000-0000-0000-0000-000000000005
  Name: Character
  Transform:
    Position: { X: 0.0, Y: 0.0, Z: 0.0 }
    # The imported figure is Z-up and faces its own +X: the entity stands it up (-90 about X), then
    # yaws it to face the camera, which looks towards +Z.
    Rotation: { X: -0.5, Y: 0.5, Z: 0.5, W: 0.5 }
    Scale: { X: 1.0, Y: 1.0, Z: 1.0 }
  MeshRenderer:
    Mesh: { Guid: 1c7c1605-84e3-4032-b04f-38ee57feea73, PackageId: com.arisen.samples }
    Material: { Guid: d5219005-c65b-424b-8877-c96465149a92, PackageId: com.arisen.samples }
    Visible: true
