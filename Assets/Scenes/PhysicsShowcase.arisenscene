# The physics capability sample: static geometry plus rigid bodies that fall, collide, and settle.
# Every collision shape is authored explicitly next to the mesh that shows it, with the shape
# center offset because these meshes have their origin at their base.
Version: 2
Name: Physics Showcase
ComponentSchemas:
- TypeId: 1
  Name: Transform
  Version: 1
  Required: true
- TypeId: 2
  Name: Camera
  Version: 2
  Required: true
- TypeId: 3
  Name: MeshRenderer
  Version: 1
  Required: true
- TypeId: 4
  Name: DirectionalLight
  Version: 1
  Required: true
- TypeId: 7
  Name: Environment
  Version: 1
  Required: true
- TypeId: 1346918722
  Name: RigidBody
  Version: 1
  Required: false
Entities:
- Guid: 42000000-0000-0000-0000-000000000001
  Name: Main Camera
  Transform:
    Position: { X: 0.0, Y: 3.5, Z: -9.0 }
    Rotation: { X: 0.1045, Y: 0.0, Z: 0.0, W: 0.9945 }
    Scale: { X: 1.0, Y: 1.0, Z: 1.0 }
  Camera:
    VerticalFov: 45.0
    NearPlane: 0.1
    FarPlane: 200.0
    IsPerspective: true
- Guid: 42000000-0000-0000-0000-000000000002
